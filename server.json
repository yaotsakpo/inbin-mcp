{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.yaotsakpo/inbin",
  "description": "Query Inbin's parsed email events (newsletters, invoices, alerts) as typed JSON tools.",
  "repository": {
    "url": "https://github.com/yaotsakpo/inbin-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@inbin/mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "INBIN_API_KEY",
          "description": "Your Inbin API key (starts with ink_live_). Get one at https://inbin.dev/dashboard.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.inbin.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your-inbin-api-key>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}